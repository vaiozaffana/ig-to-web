APP_NAME="Instagram Article Automation"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/ig_automation.db
REDIS_URL=redis://localhost:6379/0
ADMIN_API_KEY=change-me

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_LIMIT=10
USE_FAKE_INSTAGRAM=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# WhatsApp via Baileys (WhatsApp Web API) - tidak perlu Meta Business credentials
WHATSAPP_SERVICE_URL=http://localhost:3001
# Format nomor private: +628979755323 atau 628979755323
WHATSAPP_ADMIN_PHONE=
# Format group ID: 120363XXXXX@g.us (dapatkan dari Baileys logs atau group info)
WHATSAPP_GROUP_ID=
# Mode notifikasi: "private" (kirim ke WHATSAPP_ADMIN_PHONE) atau "group" (kirim ke WHATSAPP_GROUP_ID)
WHATSAPP_NOTIFICATION_MODE=private

MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

PUBLISH_ADAPTER=mock
PUBLIC_BASE_URL=http://localhost:8000
WORKER_CONCURRENCY=1
TASK_MAX_RETRIES=3
